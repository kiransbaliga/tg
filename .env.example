# Get these from https://my.telegram.org  ->  "API development tools"
TG_API_ID=
TG_API_HASH=

# Supabase Postgres connection string.
# IMPORTANT: use the CONNECTION POOLER, not the direct connection.
# The direct host (db.<ref>.supabase.co) is IPv6-only and will time out
# (CONNECT_TIMEOUT) on IPv4-only networks. Grab the "Transaction pooler"
# string from: Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Note the username is postgres.<project-ref> and the port is 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Optional: open this chat by default on startup (so you don't pick each time).
# Accepts an @username, a https://t.me/... link, or a numeric chat id.
#   TG_GROUP=@my_photos_group
#   TG_GROUP=-1001234567890
# TG_GROUP=

# Port for the local gallery web server (optional, default 4321)
# PORT=4321

# Bind address (default 127.0.0.1 = this machine only). Leave as-is for a
# private, offline, single-user setup.
# HOST=127.0.0.1
